# --- Python / virtualenv ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# --- Secrets ---
# Never commit the real .env; only .env.example is tracked.
.env
.env.local
.env.production
!.env.example

# --- Local database ---
*.sqlite3
db.sqlite3

