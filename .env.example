# ==========================================================================
# Copy this file to ".env" and edit the values.  NEVER commit the real .env
# Target setup: single Windows PC in the shop, Django + PostgreSQL local.
# ==========================================================================

# --- Django core -----------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Database (PostgreSQL, created in pgAdmin) ------------------------------
# In pgAdmin: Databases -> right click -> Create -> Database...  name it shop_billing
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/shop_billing
# True = use a local SQLite file instead (handy before Postgres is ready)
USE_SQLITE=False

# --- Shop defaults (also editable in the Django admin) ---------------------
DEFAULT_CITY=Himmatnagar
CURRENCY_SYMBOL=Rs.
INVOICE_NUMBER_PREFIX=INV

# ==========================================================================
# DOCUMENT PIPELINE:  Word template -> filled .docx -> PDF -> printer
# ==========================================================================
# docx = use the shop's Word template (the real bill format)
# html = built-in HTML template via xhtml2pdf (automatic fallback)
DOCUMENT_ENGINE=docx

# The static Word bill format. Put your .docx anywhere and point this at it.
# Create a starter template with:  python manage.py docx_template --create
DOCX_TEMPLATE_PATH=D:/Personal_Fav_projects/Web_App/doc_templates/invoice_template.docx

# --- Where finished bills are stored (change these freely) ------------------
# Archived PDFs. Point at any folder, e.g. a OneDrive / backup folder.
INVOICE_PDF_DIR=D:/Personal_Fav_projects/Web_App/media/invoices
# Filled .docx copies (the editable version of each issued bill)
INVOICE_DOCX_DIR=D:/Personal_Fav_projects/Web_App/media/invoices_docx
# Keep the intermediate .docx after converting to PDF
DOCX_KEEP_INTERMEDIATE=True
# Folder layout inside the two folders above:
#   date  -> one folder per day, created automatically:  2026-08-23/
#   month -> 2026-08/     year -> 2026-27/     none -> one flat folder
INVOICE_ARCHIVE_SUBFOLDER=date

# --- DOCX -> PDF converter -------------------------------------------------
# auto        try Word first, then LibreOffice
# word        Microsoft Word via COM automation  (best fidelity, needs Word)
# libreoffice soffice --headless                 (no Word needed)
DOCX_TO_PDF_CONVERTER=auto
# Only needed if LibreOffice is installed somewhere unusual
LIBREOFFICE_PATH=

# ==========================================================================
# PRINTING
# ==========================================================================
# dummy   -> no printer attached. Saves the exact PDF to media/print_spool/
#            and records the job. Use this until the printer arrives.
# windows  -> silent printing through the Windows spooler  <-- use this later
# cups     -> Linux/macOS `lp`
# escpos   -> thermal / receipt printer
# browser  -> fall back to the browser print dialog
PRINT_BACKEND=dummy

# Blank = the Windows default printer. Exact name from Devices and Printers.
PRINTER_NAME=
PRINT_COPIES=1

# Strongly recommended for truly dialog-free printing on Windows.
# Portable download: https://www.sumatrapdfreader.org/download-free-pdf-viewer
SUMATRA_PDF_PATH=

# --- escpos backend (only for thermal printers) ----------------------------
ESCPOS_CONNECTION=network
ESCPOS_HOST=192.168.0.100
ESCPOS_PORT=9100
ESCPOS_USB_VENDOR_ID=0x04b8
ESCPOS_USB_PRODUCT_ID=0x0e15
ESCPOS_DEVICE_FILE=/dev/usb/lp0

# ==========================================================================
# EMAIL (needed for "Forgot password")
# ==========================================================================
# Dev default prints the reset link in the terminal - no SMTP needed.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@shopbilling.local
ADMIN_EMAIL=owner@example.com

# --- Security (production only; keep False for plain http on a local PC) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
